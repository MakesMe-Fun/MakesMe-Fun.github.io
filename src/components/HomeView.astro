---
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { site, projects, type Lang } from '../data/site';
import { t, path } from '../i18n';
import { getPosts } from '../lib';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = t(lang);
const posts = (await getPosts(lang)).slice(0, 4);
---
<Base lang={lang} active="home">
  <section class="hero">
    <div class="eyebrow">{site.githubUser}.github.io</div>
    <h1>{site.name[lang]}</h1>
    <p class="lead">{site.intro[lang]}</p>
    <div class="meta-row">
      <span>📍 {site.location[lang]}</span>
      {site.links.map((l) => <a href={l.url}>{l.label} ↗</a>)}
    </div>
  </section>

  <h2>{u.latest}</h2>
  <PostList posts={posts} lang={lang} />
  <a class="more" href={path(lang, '/blog/')}>{u.allPosts} →</a>

  <h2>{u.projects}</h2>
  <div class="cards">
    {projects.slice(0, 2).map((p) => (
      <article class="card">
        <h3>{p.title[lang]}</h3>
        <p>{p.summary[lang]}</p>
        <div class="tags">{p.tags.map((tg) => <span class="tag">{tg}</span>)}</div>
      </article>
    ))}
  </div>
  <a class="more" href={path(lang, '/projects/')}>{u.projects} →</a>
</Base>
